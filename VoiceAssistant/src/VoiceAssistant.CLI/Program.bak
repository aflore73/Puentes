using System.Net.Http.Json;
using System.Text.Json;
using VoiceAssistant.Core.Interfaces;
using VoiceAssistant.Core.Services;

var classifier = new TextClassifier();

var dbPath = Path.Combine(AppContext.BaseDirectory, "..", "..", "..", "..", "Data", "Puentes.db");
var database = new DatabaseService(dbPath);

Console.WriteLine("VoiceAssistant con ML.NET + Qwen 2.5 + Puentes.db");
Console.WriteLine("=================================================");
Console.WriteLine($"Hoy es: {DateTime.Now:dd/MM/yyyy}");
Console.WriteLine($"MaÃ±ana es: {DateTime.Now.AddDays(1):dd/MM/yyyy}");
Console.WriteLine("Escribe 'salir' para terminar");
Console.WriteLine("");

await database.InitializeAsync();

using var httpClient = new HttpClient();
httpClient.Timeout = TimeSpan.FromSeconds(60);

while (true)
{
    Console.Write("Tu: ");
    var input = Console.ReadLine();
    
    if (string.IsNullOrWhiteSpace(input) || input.ToLower() == "salir")
        break;
    
    var result = await classifier.ClassifyAsync(input);
    Console.WriteLine($"Categoria: {result.Category} (Confianza: {result.Confidence:P0})");
    
    var context = "";
    try
    {
        context = await database.GetContextForCategoryAsync(result.Category);
        Console.WriteLine($"Contexto BD: {context}");
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Error BD: {ex.Message}");
    }
    
    Console.WriteLine("Consultando a Ollama...");
    
    var today = DateTime.Now.ToString("dd/MM/yyyy");
    var tomorrow = DateTime.Now.AddDays(1).ToString("dd/MM/yyyy");
    
    var prompt = @"
Eres un asistente personal para una persona mayor.

HOY ES: " + today + @"
MAÃ‘ANA ES: " + tomorrow + @"

SU AGENDA:
" + context + @"

LO QUE DICE EL USUARIO:
" + input + @"

INSTRUCCIONES:
1. Revisa si hay eventos para la fecha que menciona el usuario.
2. Si NO hay eventos para esa fecha, dile claramente: "No tienes eventos para [fecha]".
3. Menciona el prÃ³ximo evento disponible si existe.
4. Si el usuario quiere agregar algo nuevo, pregÃºntale la fecha y hora.
5. Responde en mÃ¡ximo 2 frases, de manera clara y amable.
";
    
    var request = new
    {
        model = "qwen2.5:1.5b",
        prompt = prompt,
        stream = false,
        options = new { temperature = 0.3, num_predict = 120 }
    };
    
    try
    {
        var response = await httpClient.PostAsJsonAsync("http://localhost:11434/api/generate", request);
        response.EnsureSuccessStatusCode();
        
        var jsonResponse = await response.Content.ReadFromJsonAsync<OllamaApiResponse>();
        
        var cleanResponse = jsonResponse.Response.Trim();
        Console.WriteLine($"Asistente: {cleanResponse}");
        
        try
        {
            await database.SaveConversationAsync(input, cleanResponse, result.Category, result.Confidence);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error guardando: {ex.Message}");
        }
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Error: {ex.Message}");
    }
    
    Console.WriteLine("------------------------------------------");
}

Console.WriteLine("Hasta luego!");

public class OllamaApiResponse
{
    public string Response { get; set; } = "";
    public bool Done { get; set; }
}