{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Developer": {
    "InteractiveConversation": true
  },
  "Patient": {
    "Id": "11111111-1111-1111-1111-111111111111"
  },
  "Audio": {
    "TranscriptionProvider": "Whisper",
    "SpeechProvider": "Piper",
    "Whisper": {
      "ModelPath": "models/ggml-base.bin",
      "Language": "es",
      "InitialPrompt": "Conversacion en espanol argentino. Nombres: Marta, Ezequiel, Ana, Giano y Alejandra. Lugares: Caseros y Nordelta."
    },
    "Piper": {
      "ExecutablePath": "python",
      "ExecutableArguments": [ "-m", "piper" ],
      "ModelPath": "voices/es_AR-daniela-high.onnx",
      "LengthScale": 1.25,
      "SentenceSilence": 0.4,
      "StartSilenceMilliseconds": 500,
      "EndSilenceMilliseconds": 700
    }
  }
}
